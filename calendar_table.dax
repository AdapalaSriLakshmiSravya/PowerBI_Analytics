-- Modeling > New Table.  Replace Orders if your fact table is named differently.
Calendar =
ADDCOLUMNS(
    CALENDAR(MIN(Orders[Order Date]), MAX(Orders[Order Date])),
    "Year", YEAR([Date]),
    "Quarter", "Q" & QUARTER([Date]),
    "QuarterNum", QUARTER([Date]),
    "Month", FORMAT([Date], "MMM"),
    "MonthNum", MONTH([Date]),
    "Half Year", IF(MONTH([Date]) <= 6, "H1", "H2"),
    "Year-Month", FORMAT([Date], "YYYY-MMM"),
    "Year-MonthNum", YEAR([Date]) * 100 + MONTH([Date])
)

-- After creating:
-- 1. Month        > Sort by column > MonthNum
-- 2. Quarter      > Sort by column > QuarterNum
-- 3. Year-Month   > Sort by column > Year-MonthNum
-- 4. Table tools > Mark as Date Table > Date column
-- 5. Relationship: Calendar[Date] 1 -> * Orders[Order Date] (single direction, active)
-- 6. Optional:     Calendar[Date] -> Orders[Ship Date] (inactive; use USERELATIONSHIP)

-- Hidden measures table
_Measures = { BLANK() }

-- Ship-date measure example
Sales by Ship Date =
CALCULATE([Total Sales], USERELATIONSHIP(Calendar[Date], Orders[Ship Date]))
